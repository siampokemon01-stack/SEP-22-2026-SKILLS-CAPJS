{
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "command": "cds watch --profile hybrid",
        "name": "CAP Debug Session",
        "request": "launch",
        "type": "node-terminal",
        "cwd": "${workspaceFolder}"
      }
    ]
  },
  "folders": [
    {
      "path": "purchaseorder"
    }
  ],
  "settings": {
    "SAP HANA Database Explorer.ShowXsAdvancedConnections": true
  },
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Purchaseorder-1",
      "runtimeExecutable": "cds",
      "request": "launch",
      "killBehavior": "polite",
      "args": [
        "watch",
        "--open"
      ],
      "console": "internalConsole",
      "internalConsoleOptions": "openOnSessionStart",
      "type": "pwa-node",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "dev-project-cap",
      "envFile": "${workspaceFolder}/env/.env1",
      "env": {
        "run.config": "{\"handlerId\":\"lcap_run_config_handler_id\",\"runnableId\":\"{\\\"projectPath\\\":\\\"/home/user/projects/Purchaseorder\\\",\\\"profileName\\\":\\\"\\\"}\"}"
      }
    }
  ]
}